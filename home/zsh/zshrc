# using http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -o errexit
set -o pipefail

typeset -U path cdpath fpath manpath # prevent duplicates in paths

unset __HM_SESS_VARS_SOURCED && source /etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh
set -o nounset

mkdir -p $XDG_CACHE_HOME/zsh
mkdir -p $XDG_DATA_HOME/zsh

ZSH_CONFIG_HOME=${ZDOTDIR}
source "${ZSH_CONFIG_HOME}/colours.zsh"
source "${ZSH_CONFIG_HOME}/options.zsh"
source "${ZSH_CONFIG_HOME}/aliases.zsh"
source "${ZSH_CONFIG_HOME}/aliases.agentic.zsh"
source "${ZSH_CONFIG_HOME}/aliases.docker.zsh"
source "${ZSH_CONFIG_HOME}/aliases.git.zsh"
source "${ZSH_CONFIG_HOME}/aliases.k8s.zsh"
source "${ZSH_CONFIG_HOME}/aliases.nix.zsh"
source "${ZSH_CONFIG_HOME}/bindkeys.zsh"
source "${ZSH_CONFIG_HOME}/completions.zsh"
source "${ZSH_CONFIG_HOME}/prompt.zsh"
source "${ZSH_CONFIG_HOME}/widgets.zsh"

# cached `brew shellenv zsh` — regenerated only when the brew binary changes
() {
  local brew=/opt/homebrew/bin/brew
  local cache=$XDG_CACHE_HOME/zsh/brew-shellenv.zsh
  if [[ -x $brew ]]; then
    if [[ ! -s $cache || $brew -nt $cache ]]; then
      mkdir -p ${cache:h}
      $brew shellenv zsh >| $cache
    fi
    source $cache
  fi
}

zsh-defer -c 'eval "$(mise activate zsh)"'
zsh-defer -c 'eval "$(fnox activate zsh)"'
zsh-defer source "${ZSH_CONFIG_HOME}/completions.cache.zsh"

# OrbStack command-line tools and integration
zsh-defer -c 'source ~/.orbstack/shell/init.zsh 2>/dev/null'

# add worktrunk shell extension & completions
zsh-defer -c 'eval "$(command wt config shell init zsh)"'

set +o errexit
set +o nounset
