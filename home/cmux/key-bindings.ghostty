# split panes
keybind = alt+shift+backslash=new_split:right
keybind = alt+shift+'=new_split:down

# pane navigation
keybind = alt+shift+left=goto_split:left
keybind = alt+shift+right=goto_split:right
keybind = alt+shift+up=goto_split:top
keybind = alt+shift+down=goto_split:bottom

# toggle pane zoom
keybind = alt+shift+enter=toggle_split_zoom

# clear scrollback
keybind = super+shift+k=clear_screen

keybind = alt+backspace=text:\x1b[3~

macos-option-as-alt = left
